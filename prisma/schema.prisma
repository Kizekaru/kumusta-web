datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model School {
  id        String   @id @default(uuid())
  name      String
  division  String   @default("Pampanga")
  latitude  Float
  longitude Float
  alerts    Alert[]
  createdAt DateTime @default(now())
}

model ClassroomCourse {
  id          String                 @id @default(uuid())
  courseId    String                 @unique
  name        String
  section     String                 @default("Grade 11 - STEM A")
  submissions ClassroomSubmission[]
  createdAt   DateTime               @default(now())
}

model ClassroomSubmission {
  id           String          @id @default(uuid())
  courseId     String
  course       ClassroomCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId    String          @default("demo-student-juan")
  title        String
  assignedDate DateTime
  dueDate      DateTime
  grade        Float
  maxPoints    Float           @default(50.0)
  createdAt    DateTime        @default(now())
}

model Alert {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId        String
  severity         String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  classification   String   // "SUICIDE_RISK", "SELF_HARM", "BULLYING", "CRISIS", "ACADEMIC_DISTRESS"
  flaggedText      String
  counselorSummary String?  @db.Text
  doSay            String[]
  dontSay          String[]
  isAnonymous      Boolean  @default(true)
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
}
